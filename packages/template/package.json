{
  "name": "@terrarium/template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "tickets": "./src/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "tickets": "node --experimental-strip-types src/cli.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test": "vitest run",
    "typecheck": "tsrs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@effect/platform-node": "^4.1.5",
    "@terrarium/auth": "workspace:*",
    "alchemy": "2.0.0-beta.87",
    "drizzle-orm": "^0.44.0",
    "effect": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
