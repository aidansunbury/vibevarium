# Caddy reverse proxy — auto-TLS via Let's Encrypt.
# DOMAIN is substituted at deploy time (envsubst).

# Casdoor serves the API, the OIDC/discovery endpoints, and the admin console
# from a single port (8000). One origin covers everything; the admin console is
# reachable at auth.<domain>/ (built-in org) — no separate admin origin needed
# (unlike Logto's split-core/admin setup).
auth.{$DOMAIN} {
	reverse_proxy casdoor:8000
}

platform.{$DOMAIN} {
	reverse_proxy control-plane:4100
}
