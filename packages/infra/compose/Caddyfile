# Caddy reverse proxy — auto-TLS via Let's Encrypt.
# DOMAIN is substituted at deploy time (envsubst).

auth.{$DOMAIN} {
	# Admin console is a separate Logto app on port 3002, served under /console.
	handle /console* {
		reverse_proxy logto:3002
	}

	handle {
		reverse_proxy logto:3001
	}
}

platform.{$DOMAIN} {
	reverse_proxy control-plane:4100
}
