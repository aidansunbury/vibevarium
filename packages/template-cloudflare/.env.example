CLOUDFLARE_ACCOUNT_ID=7bbaa8f97d6ababf1a5e29eb79491ce3
WORKER_NAME=vibevarium-tickets-cloudflare
D1_DATABASE_NAME=vibevarium-tickets-cloudflare-data
STACK_NAME=TerrariumTicketsCloudflare

# Optional per-app R2 bucket, bound for reads and writes as `TicketsBucket`.
#R2_BUCKET_NAME=

# Optional auth seam. Leave TERRARIUM_ISSUER unset for unauthenticated local
# dev (all surfaces open). When set, every API surface requires a credential
# from this issuer; unauthenticated API requests 401 with WWW-Authenticate,
# and browser requests bounce to /auth/login → the hosted sign-in.
#TERRARIUM_ISSUER=
#TERRARIUM_AUDIENCE=
#TERRARIUM_PLATFORM_AUDIENCE=

# The per-app OIDC client (Logto "Traditional web") powering the SPA's
# auth-code + PKCE login (see src/auth-flow.ts). The scaffold's Logto
# auto-registration creates the client and provides both values at deploy
# time; the secret must be a worker secret, never committed. Unset → the
# session flow is off and only bearer auth applies (local dev default).
#TERRARIUM_CLIENT_ID=
#TERRARIUM_CLIENT_SECRET=

# Public origin used to build the OAuth redirect_uri. Defaults to the
# request's own origin (correct behind the custom domain); set only to pin it.
#TERRARIUM_APP_ORIGIN=
